---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nie znaleziono strony | Na ile do pierdla?</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#f5f3ee">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
</head>
<body>
    <header class="topbar">
        <div class="wrap topbar-inner">
            <a href="/" class="wordmark">nailedopierdla.pl</a>
            <span class="topbar-meta">Kalkulator wymiaru kary</span>
        </div>
    </header>
    <main class="wrap notfound">
        <p class="eyebrow">Błąd 404</p>
        <h1>Nie ma takiej strony</h1>
        <p class="lede">Postępowanie umorzono z braku przedmiotu.</p>
        <a href="/" class="button-link">Wróć do kalkulatora</a>
    </main>
</body>
</html>
