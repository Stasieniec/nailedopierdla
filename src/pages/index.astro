---
import '../styles/global.css';

const siteTitle = "Na ile do pierdla? Kalkulator wymiaru kary";
const siteDescription = "Kalkulator oparty na Kodeksie karnym i Kodeksie wykroczeń. Wybierz, ile chcesz posiedzieć, i sprawdź, które czyny to zapewnią.";
const siteUrl = "https://nailedopierdla.pl";
const siteImage = `${siteUrl}/og-image.png`;
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription}>
    <link rel="canonical" href={siteUrl + "/"}>

    <meta property="og:type" content="website">
    <meta property="og:url" content={siteUrl + "/"}>
    <meta property="og:title" content="Na ile do pierdla?">
    <meta property="og:description" content={siteDescription}>
    <meta property="og:image" content={siteImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="Na ile do pierdla?">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Na ile do pierdla?">
    <meta name="twitter:description" content={siteDescription}>
    <meta name="twitter:image" content={siteImage}>

    <meta name="theme-color" content="#f4f5f6">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Na ile do pierdla?",
      "description": "Kalkulator wymiaru kary oparty na Kodeksie karnym i Kodeksie wykroczeń.",
      "url": "https://nailedopierdla.pl/",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Any",
      "inLanguage": "pl-PL",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "PLN" }
    }
    </script>
</head>
<body>
    <header class="topbar">
        <div class="wrap topbar-inner">
            <a href="/" class="wordmark">nailedopierdla.pl</a>
            <span class="topbar-meta">Kalkulator wymiaru kary</span>
        </div>
    </header>

    <main class="wrap">
        <section class="intro">
            <p class="eyebrow">Kodeks karny · Kodeks wykroczeń</p>
            <h1>Na ile do pierdla?</h1>
            <p class="lede">
                Przygniatający ciężar rzeczywistości sprawia, że chcesz zniknąć na parę lat? Może by tak pójść do więzienia na zimę? Albo przeczekać lato w klimatyzowanej celi? Wpisz wybrany okres czasu i dowiedz się, jakie przestępstwa go gwarantują.
            </p>
        </section>

        <div class="calc">
            <section class="panel form" aria-label="Wybór okresu">
                <h2 class="panel-label">Wymiar kary</h2>
                <output id="time-display" class="readout" for="time-slider" aria-live="polite">1 rok</output>

                <input
                    type="range"
                    id="time-slider"
                    min="0.033"
                    max="300"
                    step="0.033"
                    value="12"
                    class="slider"
                    aria-label="Wymiar kary"
                >
                <div class="scale"><span>1 dzień</span><span>25 lat</span></div>

                <div class="field">
                    <label for="time-input">Dokładnie</label>
                    <div class="field-row">
                        <input type="number" id="time-input" min="1" max="300" value="12" inputmode="decimal">
                        <select id="time-unit" aria-label="Jednostka">
                            <option value="days">dni</option>
                            <option value="months" selected>miesięcy</option>
                            <option value="years">lat</option>
                        </select>
                    </div>
                </div>

                <label class="check">
                    <input type="checkbox" id="life-sentence">
                    <span>Dożywocie</span>
                </label>

                <button id="calculate-btn" type="button">Oblicz</button>
            </section>

            <section id="results" class="panel results" aria-label="Wyliczenie" aria-live="polite">
                <div class="results-head">
                    <h2 class="panel-label">Wyliczenie</h2>
                    <p class="results-total" id="result-time"></p>
                </div>
                <ol id="crimes-list" class="positions"></ol>
                <div id="sum-row" class="sum" hidden>
                    <span>Razem</span>
                    <span id="sum-value"></span>
                </div>
                <p id="sum-note" class="footnote" hidden>
                    Suma kar jednostkowych. Za kilka przestępstw sąd wymierza karę łączną (art. 85 i nast. k.k.), która może być niższa od sumy.
                </p>
            </section>
        </div>
    </main>

    <footer class="wrap footer">
        <p>Kary według Kodeksu karnego i Kodeksu wykroczeń.</p>
        <p>Serwis ma charakter wyłącznie informacyjny i nie stanowi porady prawnej.</p>
    </footer>

    <script>
        const offencesPL = [
            // WYKROCZENIA (KW) – minor offenses with arrests in days
            { name: "Niszczenie lub uszkadzanie drzew/krzewów (wykroczenie)", law: "KW", basis: "art. 162", penalty: "areszt / ograniczenie wolności / grzywna", minMonths: 0.033, maxMonths: 1 },
            { name: "Niszczenie lub uszkadzanie urządzeń użytku publicznego", law: "KW", basis: "art. 124a", penalty: "areszt do 30 dni / ograniczenie wolności / grzywna", minMonths: 0.033, maxMonths: 1 },
            { name: "Kradzież do 800 zł (wykroczenie)", law: "KW", basis: "art. 119 §1", penalty: "areszt / ograniczenie wolności / grzywna", minMonths: 0.5, maxMonths: 1 },
            { name: "Zakłócanie spokoju / porządku publicznego", law: "KW", basis: "art. 51", penalty: "areszt / ograniczenie wolności / grzywna", minMonths: 0.5, maxMonths: 1 },
            { name: "Uszkodzenie lub zniszczenie mienia do 800 zł (wykroczenie)", law: "KW", basis: "art. 124 §1", penalty: "areszt / ograniczenie wolności / grzywna", minMonths: 0.5, maxMonths: 1 },
            { name: "Prowadzenie pojazdu w stanie po użyciu alkoholu (wykroczenie)", law: "KW", basis: "art. 87", penalty: "areszt albo grzywna (min. 2500 zł) + zakaz prowadzenia", minMonths: 0.5, maxMonths: 1 },
            { name: "Nielegalne przekraczanie granicy (wykroczenie)", law: "KW", basis: "art. 49", penalty: "areszt / grzywna", minMonths: 0.033, maxMonths: 1 },
            { name: "Zakłócanie porządku w miejscach publicznych", law: "KW", basis: "art. 141", penalty: "areszt / ograniczenie wolności / grzywna", minMonths: 0.033, maxMonths: 1 },

            // PRZESTĘPSTWA KRÓTKOTERMINOWE (do 2 lat)
            { name: "Groźba karalna", law: "KK", basis: "art. 190 §1", penalty: "pozb. woln. do 3 lat", minMonths: 1, maxMonths: 36 },
            { name: "Naruszenie miru domowego (wtargnięcie / nieopuszczenie terenu)", law: "KK", basis: "art. 193", penalty: "grzywna / ograniczenie / pozb. woln. do 1 roku", minMonths: 1, maxMonths: 12 },
            { name: "Złośliwe przeszkadzanie pogrzebowi / obrzędom", law: "KK", basis: "art. 195", penalty: "grzywna / ograniczenie / pozb. woln. do 2 lat", minMonths: 1, maxMonths: 24 },
            { name: "Znieważenie pomnika lub miejsca pamięci", law: "KK", basis: "art. 261", penalty: "grzywna / ograniczenie wolności", minMonths: 0.5, maxMonths: 2 },
            { name: "Obraza uczuć religijnych", law: "KK", basis: "art. 196", penalty: "grzywna / ograniczenie / pozb. woln. do 2 lat", minMonths: 1, maxMonths: 24 },
            { name: "Nielegalne udostępnianie danych osobowych", law: "KK", basis: "art. 267a", penalty: "pozb. woln. do 2 lat", minMonths: 1, maxMonths: 24 },

            // PRZESTĘPSTWA ŚREDNIOTERMINOWE (3 mies. – 5 lat)
            { name: "Kradzież", law: "KK", basis: "art. 278 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Zabór pojazdu w celu krótkotrwałego użycia (tzw. joyriding)", law: "KK", basis: "art. 289 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Zniszczenie cudzej rzeczy (np. graffiti jako szkoda)", law: "KK", basis: "art. 288 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Paserstwo (handel/ukrywanie rzeczy z przestępstwa)", law: "KK", basis: "art. 291 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Fałszowanie dokumentu", law: "KK", basis: "art. 270 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Znęcanie się", law: "KK", basis: "art. 207 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },
            { name: "Pobicie / bójka (podstawowy typ)", law: "KK", basis: "art. 158 §1", penalty: "pozb. woln. do 3 lat", minMonths: 1, maxMonths: 36 },
            { name: "Prowadzenie pojazdu w stanie nietrzeźwości (przestępstwo)", law: "KK", basis: "art. 178a §1", penalty: "pozb. woln. do 3 lat", minMonths: 1, maxMonths: 36 },
            { name: "Bezprawne pozbawienie wolności (podstawowy)", law: "KK", basis: "art. 189 §1", penalty: "pozb. woln. 3 mies. – 5 lat", minMonths: 3, maxMonths: 60 },

            // PRZESTĘPSTWA ŚREDNIO-POWAŻNE (6 mies. – 8/10 lat)
            { name: "Kradzież szczególnie zuchwała", law: "KK", basis: "art. 278 §3a", penalty: "pozb. woln. 6 mies. – 8 lat", minMonths: 6, maxMonths: 96 },
            { name: "Oszustwo", law: "KK", basis: "art. 286 §1", penalty: "pozb. woln. 6 mies. – 8 lat", minMonths: 6, maxMonths: 96 },
            { name: "Uporczywe nękanie / kradzież tożsamości", law: "KK", basis: "art. 190a §1–2", penalty: "pozb. woln. 6 mies. – 8 lat", minMonths: 6, maxMonths: 96 },
            { name: "Nielegalne posiadanie broni palnej lub amunicji", law: "KK", basis: "art. 263 §2", penalty: "pozb. woln. 6 mies. – 8 lat", minMonths: 6, maxMonths: 96 },
            { name: "Kradzież z włamaniem", law: "KK", basis: "art. 279 §1", penalty: "pozb. woln. 1 – 10 lat", minMonths: 12, maxMonths: 120 },
            { name: "Uszkodzenie podmorskiego kabla (tak, serio)", law: "KK", basis: "art. 288 §3", penalty: "pozb. woln. 1 – 10 lat", minMonths: 12, maxMonths: 120 },
            { name: "Bezprawne pozbawienie wolności dłużej niż 7 dni", law: "KK", basis: "art. 189 §2", penalty: "pozb. woln. 1 – 10 lat", minMonths: 12, maxMonths: 120 },
            { name: "Zgwałcenie", law: "KK", basis: "art. 197 §1", penalty: "pozb. woln. 2 – 15 lat", minMonths: 24, maxMonths: 180 },
            { name: "Udział w zorganizowanej grupie przestępczej", law: "KK", basis: "art. 258 §1", penalty: "pozb. woln. 3 mies. – 5 lat (w zw. z innymi: do 15 lat)", minMonths: 3, maxMonths: 180 },

            // PRZESTĘPSTWA POWAŻNE (2-15 lat)
            { name: "Spowodowanie ciężkiego uszczerbku na zdrowiu", law: "KK", basis: "art. 156 §1", penalty: "pozb. woln. 1 – 10 lat", minMonths: 12, maxMonths: 120 },
            { name: "Rozbój (napad z użyciem przemocy)", law: "KK", basis: "art. 280 §1", penalty: "pozb. woln. 2 – 15 lat", minMonths: 24, maxMonths: 180 },
            { name: "Wymuszenie rozbójnicze", law: "KK", basis: "art. 282", penalty: "pozb. woln. 1 – 10 lat", minMonths: 12, maxMonths: 120 },
            { name: "Porwanie dla okupu", law: "KK", basis: "art. 252 §2", penalty: "pozb. woln. 3 – 20 lat", minMonths: 36, maxMonths: 240 },
            { name: "Produkcja lub handel znacznymi ilościami narkotyków", law: "", basis: "art. 63 ustawy o przeciwdziałaniu narkomanii", penalty: "pozb. woln. 2 – 15 lat", minMonths: 24, maxMonths: 180 },

            // PRZESTĘPSTWA BARDZO POWAŻNE (3-25 lat)
            { name: "Zabójstwo", law: "KK", basis: "art. 148 §1", penalty: "pozb. woln. 8 – 15 lat / 25 lat / dożywocie", minMonths: 96, maxMonths: 300 },
            { name: "Zabójstwo ze szczególnym okrucieństwem", law: "KK", basis: "art. 148 §2", penalty: "pozb. woln. 12 – 25 lat / dożywocie", minMonths: 144, maxMonths: 300 },
            { name: "Handel ludźmi", law: "KK", basis: "art. 189a §1", penalty: "pozb. woln. 3 – 20 lat", minMonths: 36, maxMonths: 240 },
            { name: "Wzięcie zakładnika", law: "KK", basis: "art. 252 §1", penalty: "pozb. woln. 3 – 20 lat", minMonths: 36, maxMonths: 240 },
            { name: "Spowodowanie katastrofy w ruchu lądowym ze skutkiem śmiertelnym", law: "KK", basis: "art. 173 §4", penalty: "pozb. woln. 2 – 15 lat", minMonths: 24, maxMonths: 180 },
            { name: "Terroryzm", law: "KK", basis: "art. 115 §20 + 148", penalty: "pozb. woln. do 25 lat / dożywocie", minMonths: 60, maxMonths: 300 },
            { name: "Zdrada kraju", law: "KK", basis: "art. 127", penalty: "pozb. woln. 5 – 25 lat / dożywocie", minMonths: 60, maxMonths: 300 },
        ];

        function calculateCrimes(targetMonths: number) {
            const result: Array<{
                crime: typeof offencesPL[0], 
                count: number, 
                targetPerCrime: number,
                severityTip: string
            }> = [];
            let remainingMonths = targetMonths;
            
            // Shuffle crimes for variety and randomness
            const shuffledCrimes = [...offencesPL].sort(() => Math.random() - 0.5);
            
            // Track what severity levels we've used (to encourage variety)
            const usedSeverityLevels = new Set<string>(); // 'low', 'medium', 'high'
            
            // Helper function to score how "round" a number is
            function getRoundnessScore(months: number): number {
                // Perfect whole years get highest score
                if (months % 12 === 0) return 3.0;
                
                // Half years (6, 18, 30, etc.)
                if (months % 6 === 0) return 2.5;
                
                // Quarter years (3, 9, 15, 21, etc.)
                if (months % 3 === 0) return 2.0;
                
                // Nice single-digit months (1-6)
                if (months >= 1 && months <= 6) return 1.5;
                
                // Other values get lower scores
                return 1.0;
            }
            
            // Score each crime based on how well it fits the remaining target
            function scoreCrime(crime: typeof offencesPL[0], remaining: number) {
                const avgSentence = (crime.minMonths + crime.maxMonths) / 2;
                const range = crime.maxMonths - crime.minMonths;
                
                // Try different count options (prefer lower counts)
                let bestCountScore = -1;
                let bestCount = 1;
                let bestTargetPerCrime = 0;
                
                // Test counts from 1 to 2 (strongly prefer single instances)
                for (let testCount = 1; testCount <= Math.min(2, Math.ceil(remaining / crime.minMonths)); testCount++) {
                    const targetPerCrime = remaining / testCount;
                    
                    // Check if target is within range
                    if (targetPerCrime < crime.minMonths || targetPerCrime > crime.maxMonths) {
                        continue;
                    }
                    
                    // Calculate position in range (0 = min, 1 = max)
                    const position = range > 0 ? (targetPerCrime - crime.minMonths) / range : 0.5;
                    
                    // HUGE bonus for round numbers!
                    const roundnessBonus = getRoundnessScore(targetPerCrime);
                    
                    // Strong preference for single instance
                    const countBonus = testCount === 1 ? 2.5 : 1.2;
                    
                    // Bonus for using different severity levels
                    let severityLevel = 'medium';
                    if (position < 0.35) severityLevel = 'low';
                    else if (position > 0.65) severityLevel = 'high';
                    const severityVarietyBonus = usedSeverityLevels.has(severityLevel) ? 1.0 : 1.4;
                    
                    // Prefer positions that aren't exactly at average (more interesting)
                    const interestBonus = 1 + Math.abs(position - 0.5) * 0.3;
                    
                    const countScore = roundnessBonus * countBonus * severityVarietyBonus * interestBonus;
                    
                    if (countScore > bestCountScore) {
                        bestCountScore = countScore;
                        bestCount = testCount;
                        bestTargetPerCrime = targetPerCrime;
                    }
                }
                
                if (bestCountScore <= 0) {
                    return { score: -1, count: 0, targetPerCrime: 0 };
                }
                
                // Additional scoring factors
                const position = range > 0 ? (bestTargetPerCrime - crime.minMonths) / range : 0.5;
                
                // Penalty for very high ranges (too flexible/boring)
                const rangePenalty = range > 100 ? 0.7 : 1;
                
                // Small random factor for variety
                const randomBonus = Math.random() * 0.3;
                
                const finalScore = bestCountScore * rangePenalty + randomBonus;
                
                return { 
                    score: finalScore, 
                    count: bestCount, 
                    targetPerCrime: bestTargetPerCrime 
                };
            }
            
            // First, break down target into nice round numbers
            function breakdownIntoRoundNumbers(total: number): number[] {
                const pieces: number[] = [];
                let remaining = total;
                
                // Strategy: prefer creating 2-4 pieces with round numbers
                // For large totals, break into nice chunks
                
                if (remaining >= 48) {
                    // For 4+ years, try to split into multiple pieces
                    const yearOptions = [48, 36, 24, 12]; // 4, 3, 2, 1 years
                    for (const yearMonths of yearOptions) {
                        if (remaining >= yearMonths && pieces.length < 3) {
                            pieces.push(yearMonths);
                            remaining -= yearMonths;
                            break; // Only take one, then move to next range
                        }
                    }
                }
                
                // Medium chunks (1-3 years)
                if (remaining >= 24 && pieces.length < 3) {
                    pieces.push(24);
                    remaining -= 24;
                } else if (remaining >= 12 && pieces.length < 3) {
                    pieces.push(12);
                    remaining -= 12;
                }
                
                // Smaller chunks (half years)
                while (remaining >= 6 && pieces.length < 4) {
                    pieces.push(6);
                    remaining -= 6;
                }
                
                // Small chunks (1-5 months)
                if (remaining >= 3 && pieces.length < 5) {
                    pieces.push(3);
                    remaining -= 3;
                }
                
                // Add remaining months as-is
                if (remaining >= 1) {
                    pieces.push(Math.round(remaining));
                }
                
                return pieces;
            }
            
            // Break target into round numbers
            const targetPieces = breakdownIntoRoundNumbers(remainingMonths);
            
            const usedCrimes = new Set<string>();
            
            // Build combination by matching crimes to our target pieces
            for (let pieceIndex = 0; pieceIndex < targetPieces.length; pieceIndex++) {
                const targetPiece = targetPieces[pieceIndex];
                
                // Find best fitting crime for THIS specific piece
                let bestCrime = null;
                let bestScore = -1;
                let bestCount = 0;
                let bestTargetPerCrime = 0;
                
                for (const crime of shuffledCrimes) {
                    if (usedCrimes.has(crime.name)) continue;
                    
                    const result = scoreCrime(crime, targetPiece);
                    if (result.score > bestScore) {
                        bestScore = result.score;
                        bestCrime = crime;
                        bestCount = result.count;
                        bestTargetPerCrime = result.targetPerCrime;
                    }
                }
                
                // If we found a good crime, use it and move to next piece
                if (bestCrime && bestScore > 0) {
                    const actualTarget = Math.min(bestTargetPerCrime, bestCrime.maxMonths);
                    
                    // Track severity level for variety
                    const range = bestCrime.maxMonths - bestCrime.minMonths;
                    const position = range > 0 ? (actualTarget - bestCrime.minMonths) / range : 0.5;
                    let severityLevel = 'medium';
                    if (position < 0.35) severityLevel = 'low';
                    else if (position > 0.65) severityLevel = 'high';
                    usedSeverityLevels.add(severityLevel);
                    
                    const severityTip = getSeverityTip(actualTarget, bestCrime.minMonths, bestCrime.maxMonths);
                    result.push({
                        crime: bestCrime,
                        count: bestCount,
                        targetPerCrime: actualTarget,
                        severityTip
                    });
                    
                    usedCrimes.add(bestCrime.name);
                    // Continue to next piece (don't break the outer loop)
                }
            }
            
            // If we still have nothing, fall back to simplest approach
            if (result.length === 0 && targetMonths > 0) {
                const crime = offencesPL.find(c => 
                    targetMonths >= c.minMonths && targetMonths <= c.maxMonths
                ) || offencesPL[0];
                
                const severityTip = getSeverityTip(targetMonths, crime.minMonths, crime.maxMonths);
                result.push({
                    crime,
                    count: 1,
                    targetPerCrime: Math.min(Math.max(targetMonths, crime.minMonths), crime.maxMonths),
                    severityTip
                });
            }
            
            return result;
        }

        // Polish forms: [1, 2-4, 5+, genitive singular]
        const UNITS = {
            day: ["dzień", "dni", "dni", "dnia"],
            month: ["miesiąc", "miesiące", "miesięcy", "miesiąca"],
            year: ["rok", "lata", "lat", "roku"],
        };

        function plural(n: number, unit: keyof typeof UNITS, genitive = false): string {
            const [one, few, many, genOne] = UNITS[unit];
            if (n === 1) return `1 ${genitive ? genOne : one}`;
            if (genitive) return `${n} ${many}`;
            const d = n % 10, h = n % 100;
            return `${n} ${d >= 2 && d <= 4 && (h < 12 || h > 14) ? few : many}`;
        }

        function formatTime(months: number, genitive = false): string {
            if (months < 1) {
                return plural(Math.max(1, Math.round(months * 30)), 'day', genitive);
            }
            let years = Math.floor(months / 12);
            let rest = Math.round(months - years * 12);
            if (rest === 12) { years += 1; rest = 0; }
            if (years === 0) return plural(rest, 'month', genitive);
            if (rest === 0) return plural(years, 'year', genitive);
            return `${plural(years, 'year', genitive)} i ${plural(rest, 'month', genitive)}`;
        }

        function getSeverityTip(targetMonths: number, minMonths: number, maxMonths: number): string {
            const range = maxMonths - minMonths;
            const position = range > 0 ? (targetMonths - minMonths) / range : 0.5;

            if (position < 0.25) {
                return "<span>Niski wymiar kary.</span> Czyn powinien być mniej poważny, sprawca skruszony, brak recydywy, okoliczności łagodzące (art. 53 k.k.).";
            } else if (position < 0.45) {
                return "<span>Poniżej średniej.</span> Ograniczona szkodliwość społeczna, brak złego zamiaru, współpraca z organami.";
            } else if (position < 0.55) {
                return "<span>Średni wymiar.</span> Standardowe okoliczności, typowy przebieg przestępstwa.";
            } else if (position < 0.75) {
                return "<span>Powyżej średniej.</span> Zwiększona szkodliwość, zaplanowane działanie, większa skala czynu.";
            } else {
                return "<span>Wysoki wymiar kary.</span> Czyn szczególnie rażący, poważne skutki, recydywa, działanie w zorganizowanej grupie, brak skruchy.";
            }
        }

        // "art. 286 §1" + "KK" -> "art. 286 § 1 k.k."
        function citation(law: string, basis: string): string {
            const code = law === 'KK' ? ' k.k.' : law === 'KW' ? ' k.w.' : '';
            return basis.replace(/§\s*/g, '§ ') + code;
        }

        function rangeText(minMonths: number, maxMonths: number): string {
            return `od ${formatTime(minMonths, true)} do ${formatTime(maxMonths, true)}`;
        }

        // Elements
        const slider = document.getElementById('time-slider') as HTMLInputElement;
        const timeDisplay = document.getElementById('time-display') as HTMLElement;
        const timeInput = document.getElementById('time-input') as HTMLInputElement;
        const timeUnit = document.getElementById('time-unit') as HTMLSelectElement;
        const lifeSentence = document.getElementById('life-sentence') as HTMLInputElement;
        const calculateBtn = document.getElementById('calculate-btn') as HTMLButtonElement;
        const resultsDiv = document.getElementById('results') as HTMLElement;
        const resultTime = document.getElementById('result-time') as HTMLElement;
        const crimesList = document.getElementById('crimes-list') as HTMLElement;
        const sumRow = document.getElementById('sum-row') as HTMLElement;
        const sumValue = document.getElementById('sum-value') as HTMLElement;
        const sumNote = document.getElementById('sum-note') as HTMLElement;

        let currentMonths = 12;
        let isLifeSentence = false;

        function convertToMonths(value: number, unit: string): number {
            switch(unit) {
                case 'days': return value / 30;
                case 'months': return value;
                case 'years': return value * 12;
                default: return value;
            }
        }

        function updateSliderFill() {
            const min = parseFloat(slider.min), max = parseFloat(slider.max);
            const pct = ((parseFloat(slider.value) - min) / (max - min)) * 100;
            slider.style.setProperty('--fill', `${pct}%`);
        }

        function updateAllInputs(months: number, fromSource: 'slider' | 'manual' | 'life') {
            currentMonths = months;
            timeDisplay.textContent = isLifeSentence ? "Dożywocie" : formatTime(months);

            if (fromSource !== 'slider') {
                slider.value = Math.min(300, Math.max(0.033, months)).toString();
            }
            updateSliderFill();

            if (fromSource !== 'manual') {
                let displayValue: number;
                switch(timeUnit.value) {
                    case 'days': displayValue = Math.round(months * 30); break;
                    case 'months': displayValue = Math.round(months); break;
                    case 'years': displayValue = Math.round(months / 12 * 100) / 100; break;
                    default: displayValue = months;
                }
                timeInput.value = displayValue.toString();
            }
        }

        slider.addEventListener('input', () => {
            if (!isLifeSentence) updateAllInputs(parseFloat(slider.value), 'slider');
        });

        timeInput.addEventListener('input', () => {
            if (!isLifeSentence) {
                const value = parseFloat(timeInput.value) || 1;
                updateAllInputs(convertToMonths(value, timeUnit.value), 'manual');
            }
        });

        timeUnit.addEventListener('change', () => {
            if (!isLifeSentence) {
                const value = parseFloat(timeInput.value) || 1;
                updateAllInputs(convertToMonths(value, timeUnit.value), 'manual');
            }
        });

        lifeSentence.addEventListener('change', () => {
            isLifeSentence = lifeSentence.checked;
            slider.disabled = isLifeSentence;
            timeInput.disabled = isLifeSentence;
            timeUnit.disabled = isLifeSentence;
            document.body.classList.toggle('is-life', isLifeSentence);
            updateAllInputs(currentMonths, 'life');
        });

        function positionHtml(index: number, title: string, cite: string, meta: Array<[string, string]>, note: string, amount: string): string {
            const metaHtml = meta.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
            return `
                <span class="pos-no">${index + 1}.</span>
                <div class="pos-body">
                    <h3>${title}</h3>
                    <p class="cite">${cite}</p>
                    <dl class="meta">${metaHtml}</dl>
                    ${note ? `<p class="note">${note}</p>` : ''}
                </div>
                <div class="pos-amount">${amount}</div>
            `;
        }

        function render() {
            crimesList.innerHTML = '';
            resultsDiv.classList.remove('is-fresh');
            void resultsDiv.offsetWidth;
            resultsDiv.classList.add('is-fresh');

            if (isLifeSentence) {
                resultTime.textContent = "Dożywocie";
                const lifeCrimes = [
                    { name: "Zabójstwo", basis: "art. 148 § 1–2 k.k.", description: "Zabójstwo ze szczególnym okrucieństwem lub w celu osiągnięcia korzyści majątkowej." },
                    { name: "Ludobójstwo", basis: "art. 118 § 1 k.k.", description: "Udział w eksterminacji grupy narodowej, etnicznej, rasowej lub religijnej." },
                    { name: "Zbrodnia przeciwko ludzkości", basis: "art. 118a k.k.", description: "Systematyczne prześladowanie grup ludności." }
                ];
                lifeCrimes.forEach((crime, index) => {
                    const li = document.createElement('li');
                    li.className = 'pos';
                    li.style.animationDelay = `${index * 60}ms`;
                    li.innerHTML = positionHtml(index, crime.name, crime.basis, [["Zagrożenie", "dożywotnie pozbawienie wolności"]], crime.description, "dożywocie");
                    crimesList.appendChild(li);
                });
                sumRow.hidden = true;
                sumNote.hidden = true;
                return;
            }

            const months = currentMonths;
            const combination = calculateCrimes(months);
            resultTime.textContent = formatTime(months);

            let total = 0;
            combination.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = 'pos';
                li.style.animationDelay = `${index * 60}ms`;
                const subtotal = item.targetPerCrime * item.count;
                total += subtotal;
                const meta: Array<[string, string]> = [["Zagrożenie", rangeText(item.crime.minMonths, item.crime.maxMonths)]];
                if (item.count > 1) meta.push(["Liczba czynów", `${item.count}, po ${formatTime(item.targetPerCrime)}`]);
                li.innerHTML = positionHtml(index, item.crime.name, citation(item.crime.law, item.crime.basis), meta, item.severityTip, formatTime(subtotal));
                crimesList.appendChild(li);
            });

            const multiple = combination.length > 1;
            sumRow.hidden = !multiple;
            sumNote.hidden = !multiple;
            sumValue.textContent = formatTime(total);
        }

        calculateBtn.addEventListener('click', () => {
            render();
            if (window.matchMedia('(max-width: 860px)').matches) {
                resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

        updateAllInputs(12, 'manual');
        render();
    </script>
</body>
</html>
